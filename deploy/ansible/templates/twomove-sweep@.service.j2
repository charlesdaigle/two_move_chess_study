[Unit]
Description=Two-move chess sweep shard %i of {{ twomove_shard_total }}
After=network.target
# {{ ansible_managed }}

[Service]
Type=simple
User={{ twomove_service_user }}
EnvironmentFile=/etc/default/twomove
WorkingDirectory={{ twomove_app_dir }}
# $SWEEP_ARGS unbraced on purpose: systemd word-splits it into arguments.
ExecStart={{ twomove_venv }}/bin/python -m twomove.sweep $SWEEP_ARGS --out ${RESULTS_DIR} --workers ${WORKERS} --shard %i/${SHARD_TOTAL}
Nice=10
{% if twomove_memory_max %}
MemoryMax={{ twomove_memory_max }}
{% endif %}
# The process exits 0 when its slice is complete; no restart loop.
Restart=no

[Install]
WantedBy=multi-user.target
